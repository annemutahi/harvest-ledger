# Copy to .env and fill in real values. NEVER commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Database. Leave blank to use local SQLite for dev.
DATABASE_URL=

# Webhook shared secret (min 32 chars). The online store must send it
# in the X-Webhook-Secret header on every POST to /api/public/orders/webhook/.
ORDERS_WEBHOOK_SECRET=

# Optional: push order status back to the online store.
STORE_API_URL=
STORE_API_KEY=

# JWT lifetimes (minutes / days)
JWT_ACCESS_MIN=30
JWT_REFRESH_DAYS=7

# Email (password reset & notifications). Leave EMAIL_HOST blank in dev to
# print emails to the console instead of sending them.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Peaceful Acres Farm <no-reply@peacefulacres.co.ke>

# Base URL of the frontend, used to build the password reset link.
FRONTEND_URL=http://localhost:8080

# SMS gateway (invoice SMS) — leave blank until a provider is connected
SMS_GATEWAY_URL=
SMS_GATEWAY_API_KEY=
SMS_SENDER_ID=PEACEFULACRES
